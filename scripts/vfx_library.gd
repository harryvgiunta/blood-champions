extends RefCounted
## The painted VFX library: flipbook fire and smoke, spark atlases, decals.
##
## `AbilityFx` and `ProcFx` used to build every effect out of two generated
## 64 px dots, which is why fire read as a ring of orange beads. This module
## loads the texture set in `assets/vfx/` (generated by `tools/fx_textures.py`)
## and hands out the three things an effect actually needs:
##
##   * **flipbook particles** - a CPUParticles3D whose quads walk an 8-frame
##     sheet over their lifetime, so a flame flickers instead of pulsing.
##   * **atlas particles** - a random tile out of the 4x4 spark sheet per
##     particle, so a burst has embers, glints and chips in it at once.
##   * **decals** - one additive quad for a ring, a crescent, a rune circle or a
##     blood splat, which is sharper and cheaper than the geometry it replaces.
##
## Every texture is cached and every function is null-safe: a build without the
## textures (a stripped export, a test harness) falls back to a flat white dot
## rather than erroring, so the game is never missing a whole class of effect.

const DIR := "res://assets/vfx/"
const FLAME := "flame_8x1"
const SMOKE := "smoke_8x1"
const SPARK := "spark_4x4"
const CRESCENT := "crescent"
const GLINT := "glint"
const RING := "shock_ring"
const RUNES := "rune_ring"
const SPLAT := "splat"

const FLAME_FRAMES := 8
const SMOKE_FRAMES := 8
const SPARK_COLUMNS := 4
const SPARK_ROWS := 4

static var _textures: Dictionary = {}
static var _dots: Texture2D


## One texture, loaded once. Answers null when the file is absent, which every
## caller treats as "draw the fallback", never as an error.
static func texture(name: String) -> Texture2D:
	if _textures.has(name):
		return _textures[name]
	var path := DIR + name + ".png"
	var loaded: Texture2D = null
	if ResourceLoader.exists(path):
		loaded = load(path) as Texture2D
	_textures[name] = loaded
	return loaded


## A soft white dot: the fallback when a sheet is missing, and the sprite the
## smoke-free effects still use for flashes.
static func dot() -> Texture2D:
	if _dots != null:
		return _dots
	var size := 64
	var image := Image.create(size, size, false, Image.FORMAT_RGBA8)
	image.fill(Color(1.0, 1.0, 1.0, 0.0))
	var centre := (float(size) - 1.0) * 0.5
	for y in size:
		for x in size:
			var offset := Vector2(float(x) - centre, float(y) - centre) / centre
			var radial := clampf(1.0 - offset.length(), 0.0, 1.0)
			var alpha := radial * radial * (3.0 - 2.0 * radial)
			image.set_pixel(x, y, Color(1.0, 1.0, 1.0, alpha * alpha))
	image.generate_mipmaps()
	_dots = ImageTexture.create_from_image(image)
	return _dots


## A soft, additive sprite material for a plain quad. `flat` pins the quad in the
## world (a floor decal) instead of turning it at the camera.
static func quad_material(texture_2d: Texture2D, tint: Color, additive: bool = true,
		flat: bool = false) -> StandardMaterial3D:
	var material := StandardMaterial3D.new()
	material.albedo_texture = texture_2d if texture_2d != null else dot()
	material.albedo_color = tint
	material.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
	material.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
	material.blend_mode = BaseMaterial3D.BLEND_MODE_ADD if additive \
		else BaseMaterial3D.BLEND_MODE_MIX
	material.billboard_mode = BaseMaterial3D.BILLBOARD_DISABLED if flat \
		else BaseMaterial3D.BILLBOARD_ENABLED
	material.billboard_keep_scale = true
	material.cull_mode = BaseMaterial3D.CULL_DISABLED
	material.texture_filter = BaseMaterial3D.TEXTURE_FILTER_LINEAR_WITH_MIPMAPS
	material.disable_receive_shadows = true
	if additive:
		material.depth_draw_mode = BaseMaterial3D.DEPTH_DRAW_DISABLED
	return material


## A decal: one quad, laid flat on the floor or turned to the camera, that fades
## and grows over `seconds`. Returns the mesh so a caller can chain motion on it.
static func decal(parent: Node3D, at: Vector3, name: String, size: Vector2,
		tint: Color, seconds: float, flat: bool = true,
		spin: float = 0.0) -> MeshInstance3D:
	if not is_instance_valid(parent):
		return null
	var quad := QuadMesh.new()
	quad.size = size
	var material := quad_material(texture(name), Color(tint.r, tint.g, tint.b, 0.0),
		true, flat)
	quad.material = material
	var node := MeshInstance3D.new()
	node.name = "VfxDecal"
	node.mesh = quad
	node.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	if flat:
		node.rotation.x = -PI * 0.5
	parent.add_child(node)
	node.global_position = at
	node.rotation.y += spin
	var tween := node.create_tween()
	tween.set_parallel(true)
	tween.tween_property(material, "albedo_color",
		Color(tint.r, tint.g, tint.b, tint.a), maxf(seconds * 0.18, 0.04))
	tween.tween_property(material, "albedo_color",
		Color(tint.r, tint.g, tint.b, 0.0), maxf(seconds * 0.82, 0.06)) \
		.set_delay(maxf(seconds * 0.18, 0.04))
	if spin != 0.0:
		tween.tween_property(node, "rotation:y", node.rotation.y + spin * 2.0,
			seconds)
	tween.set_parallel(false)
	tween.tween_callback(node.queue_free)
	return node


## Fire: flipbook particles out of `flame_8x1`. `amount` is the puff count, not a
## particle budget: each puff is one frame-walking quad.
static func flame_particles(colour: Color, amount: int, speed_min: float,
		speed_max: float, lifetime: float, size: float,
		one_shot: bool = true) -> CPUParticles3D:
	return _flipbook(FLAME, FLAME_FRAMES, 1, colour, amount, speed_min, speed_max,
		lifetime, size, one_shot, Vector3(0.0, 2.4, 0.0), 24.0)


## Smoke: the same machine on the 8-frame smoke sheet, in mix blend (smoke adds
## nothing to a scene; it hides what is behind it).
static func smoke_particles(colour: Color, amount: int, lifetime: float,
		size: float = 0.6) -> CPUParticles3D:
	var particles := _flipbook(SMOKE, SMOKE_FRAMES, 1, colour, amount, 0.3, 1.1,
		lifetime, size, true, Vector3(0.2, 0.9, 0.2), 8.0)
	particles.mesh.material.blend_mode = BaseMaterial3D.BLEND_MODE_MIX
	particles.mesh.material.depth_draw_mode = BaseMaterial3D.DEPTH_DRAW_OPAQUE_ONLY
	return particles


## Sparks: the 4x4 atlas, a different tile per particle, so a burst carries
## embers, glints, ash and chips in one emitter.
static func spark_burst(colour: Color, amount: int, speed_min: float,
		speed_max: float, lifetime: float, size: float) -> CPUParticles3D:
	var particles := CPUParticles3D.new()
	particles.amount = clampi(amount, 1, 180)
	particles.lifetime = lifetime
	particles.one_shot = true
	particles.explosiveness = 1.0
	particles.local_coords = false
	particles.emission_shape = CPUParticles3D.EMISSION_SHAPE_SPHERE
	particles.emission_sphere_radius = 0.14
	particles.direction = Vector3.UP
	particles.spread = 180.0
	particles.gravity = Vector3(0.0, -7.0, 0.0)
	particles.initial_velocity_min = speed_min
	particles.initial_velocity_max = speed_max
	particles.damping_min = 0.4
	particles.damping_max = 1.5
	particles.scale_amount_min = 0.5
	particles.scale_amount_max = 1.5
	particles.angular_velocity_min = -220.0
	particles.angular_velocity_max = 220.0
	var ramp := Gradient.new()
	ramp.offsets = PackedFloat32Array([0.0, 0.35, 1.0])
	ramp.colors = PackedColorArray([
		Color(1.0, 0.98, 0.92, 1.0),
		Color(colour.r, colour.g, colour.b, 0.95),
		Color(colour.r * 0.55, colour.g * 0.30, colour.b * 0.20, 0.0),
	])
	particles.color_ramp = ramp
	var quad := QuadMesh.new()
	quad.size = Vector2.ONE * maxf(size, 0.01) * 3.0
	var material := quad_material(texture(SPARK), colour, true, false)
	material.billboard_mode = BaseMaterial3D.BILLBOARD_PARTICLES
	material.vertex_color_use_as_albedo = true
	material.particles_anim_h_frames = SPARK_COLUMNS
	material.particles_anim_v_frames = SPARK_ROWS
	material.particles_anim_loop = false
	quad.material = material
	particles.mesh = quad
	particles.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	if "anim_offset_min" in particles:
		particles.anim_offset_min = 0.0
		particles.anim_offset_max = 0.99
	return particles


## The shared flipbook emitter. Godot animates `particles_anim_*` frames from the
## material, and `anim_speed_*` from the node, so one sheet and one material
## covers every size of flame the game asks for.
static func _flipbook(sheet: String, h_frames: int, v_frames: int, colour: Color,
		amount: int, speed_min: float, speed_max: float, lifetime: float,
		size: float, one_shot: bool, drift: Vector3,
		anim_speed: float) -> CPUParticles3D:
	var particles := CPUParticles3D.new()
	particles.amount = clampi(amount, 1, 96)
	particles.lifetime = maxf(lifetime, 0.05)
	particles.one_shot = one_shot
	particles.explosiveness = 1.0 if one_shot else 0.0
	particles.local_coords = false
	particles.emission_shape = CPUParticles3D.EMISSION_SHAPE_SPHERE
	particles.emission_sphere_radius = 0.18
	particles.direction = drift.normalized()
	particles.spread = 32.0
	particles.gravity = Vector3(0.0, -0.6, 0.0)
	particles.initial_velocity_min = speed_min
	particles.initial_velocity_max = speed_max
	particles.damping_min = 0.6
	particles.damping_max = 1.8
	particles.scale_amount_min = 0.65
	particles.scale_amount_max = 1.45
	var ramp := Gradient.new()
	ramp.offsets = PackedFloat32Array([0.0, 0.55, 1.0])
	ramp.colors = PackedColorArray([
		Color(1.0, 1.0, 1.0, 1.0),
		Color(colour.r, colour.g, colour.b, 0.9),
		Color(colour.r * 0.6, colour.g * 0.4, colour.b * 0.35, 0.0),
	])
	particles.color_ramp = ramp
	var quad := QuadMesh.new()
	quad.size = Vector2.ONE * maxf(size, 0.02) * 2.0
	var material := quad_material(texture(sheet), colour, true, false)
	material.billboard_mode = BaseMaterial3D.BILLBOARD_PARTICLES
	material.vertex_color_use_as_albedo = true
	material.particles_anim_h_frames = h_frames
	material.particles_anim_v_frames = v_frames
	material.particles_anim_loop = true
	quad.material = material
	particles.mesh = quad
	particles.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	if "anim_speed_min" in particles:
		particles.anim_speed_min = anim_speed * 0.8
		particles.anim_speed_max = anim_speed * 1.25
	if "anim_offset_max" in particles:
		particles.anim_offset_max = 0.99
	return particles
